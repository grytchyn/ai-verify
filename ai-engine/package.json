{
  "name": "ai-verify-ai-engine",
  "version": "2.0.0",
  "description": "AI-Verify AI/ML Inference Engine (OpenWebUI + LLM + VectorDB)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
